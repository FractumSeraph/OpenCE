# IDE folders
.idea/
.vs/

# Caches
__pycache__
.mypy_cache
.cache/

# Build files
build/
target/
.ninja_*
build.ninja

# Generated configs
compile_commands.json

# The January build and the Xbox SDK (tools/xdk_headers.py reads the
# build's PDB); never commit
*.exe
*.pdb
xbox/
!source/**/xbox/

# The game's log, written to the data root (a run from the repository root)
/debug.txt

# Locally extracted proprietary game data (never commit)
/assets
# (but the high-res assets, drawn for the port: tools/hud_assets.py)
!port/assets/
original/

# CI build outputs (tools/ci_build.py)
dist/
# the self-hosting server's generated and local files (services/selfhost)
/services/selfhost/public/
/services/selfhost/data/
/services/selfhost/logs/
/services/selfhost/config.json
/services/selfhost/server/node_modules/
/services/selfhost/server/signaling/
/services/selfhost/server/bin/
/services/selfhost/server/runtime/

# The Android signing key's settings (port/android/app/build.gradle reads
# them), and any key; never commit
port/android/keystore.properties
*.keystore
*.jks

# the game's log, when a run writes it at the top of the tree
/debug.txt

# A Custom Edition map's assets, made with tools/ce_asset_pack.py (never
# commit: they are the map's)
*_assets.map
