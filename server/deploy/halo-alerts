#!/usr/bin/env python3
# Discord alerts for FractumSeraph's Halo VPS (server/deploy/halo-alerts;
# installed as /usr/local/sbin/halo-alerts, run by halo-alerts.service):
#
#   - a suspect: the fair play checks' "fair play: suspect" log line
#     (port/linux/game/network_fairplay.c) on FractumFFA or FractumKing,
#     with the player's name, why, and the game's recording (network.record_games):
#     links to watch the game live in the replay viewer (30 seconds behind)
#     and, once the game is over, to its public recording at the moment the
#     line came (half a minute before it), following the player;
#   - a game server that crashed (systemd: its process dumped core or was
#     killed by a signal), which systemd starts again within seconds, too
#     soon for the minute's checks to see;
#   - something down: a game server, the web services, Caddy, the tracker or
#     MQTT not running; the site, the lobby or a server's place on the game
#     list not answering; little disk left; a server update, backup or ban
#     list run, or a move of recordings to the seedbox, that failed. Said once when it has lasted a few minutes (the
#     game list: ten, it is slow to notice), and again when it is back.
#
# The webhook is /etc/halo-alerts/webhook (its URL, one line, readable by
# root alone): a webhook posts to its Discord channel for anyone who has it.
# No address or hardware id is sent (Discord is someone else's): the control
# panel's Suspects tab has them. Its own log: journalctl -u halo-alerts.
import calendar
import json
import os
import subprocess
import sys
import threading
import time
import urllib.error
import urllib.parse
import urllib.request

WEBHOOK_FILE = "/etc/halo-alerts/webhook"
NAME = "Halo servers"
PANELS = {"FractumFFA": "https://halovps.fractumseraph.net:8443/", "FractumKing": "https://halovps.fractumseraph.net:8444/"}
# the replay viewer, and each server's public recordings: the live game's
# folder (Caddy, here) and where finished ones are kept (the seedbox's,
# halo-recordings-offload)
VIEWER = "https://halo.fractumseraph.net/assets/replay/"
PUBLIC = {
    "halo-dedicated": ("https://halovps.fractumseraph.net/replays/fractumffa/",
                       "https://halo.fractumseraph.net/replays/halo-dedicated/"),
    "halo-fractumslayer": ("https://halovps.fractumseraph.net/replays/fractumslayer/",
                           "https://halo.fractumseraph.net/replays/halo-fractumslayer/"),
}
# how long before the suspect line the replay link starts
REPLAY_LEAD_SECONDS = 30
# the game servers: their units, names on the game list, and data folders
SERVERS = {
    "halo-dedicated": ("FractumFFA", "/opt/halo-dedicated/data"),
    "halo-fractumslayer": ("FractumKing", "/opt/halo-fractumslayer/data"),
}
# what must be running, and what must not have failed (oneshots run by timers)
RUNNING = ["halo-dedicated", "halo-fractumslayer", "halo", "caddy", "opentracker", "mosquitto"]
NOT_FAILED = ["halo-gameservers-update", "halo-backup", "halo-bans-publish", "halo-recordings-offload"]
SITE = "https://halo.fractumseraph.net/"
LOBBY = "http://127.0.0.1:8765/v1/public-games"
GAME_LIST = "https://halo.milenko.org/v1/games"
DISK_PATH = "/opt"
DISK_MINIMUM = 2 * 1024 ** 3
# a check's failures in a row (a minute apart) before it is said, and the game list's
FAILURES_TO_ALERT = 3
GAME_LIST_FAILURES_TO_ALERT = 10
# the same player's suspicion said once in this long
SUSPECT_REPEAT_SECONDS = 15 * 60


def log(text):
    print(text, flush=True)


def webhook():
    try:
        with open(WEBHOOK_FILE, encoding="utf-8") as file:
            url = file.read().strip()
    except OSError:
        return None
    return url if url.startswith("https://discord.com/api/webhooks/") or url.startswith(
        "https://discordapp.com/api/webhooks/") else None


send_lock = threading.Lock()


def send(text):
    """posts the text to the channel (Discord's 2000 characters at most), waiting out its rate limits"""
    url = webhook()
    if not url:
        log(f"no webhook in {WEBHOOK_FILE}; would have said: {text}")
        return
    body = json.dumps({"username": NAME, "content": text[:1900], "allowed_mentions": {"parse": []}}).encode()
    with send_lock:
        for _ in range(5):
            request = urllib.request.Request(url, data=body, method="POST", headers={
                "Content-Type": "application/json", "User-Agent": "halo-alerts (FractumSeraph's Halo VPS)"})
            try:
                urllib.request.urlopen(request, timeout=20).read()
                return
            except urllib.error.HTTPError as error:
                if error.code == 429:
                    try:
                        wait = float(json.loads(error.read() or b"{}").get("retry_after", 2))
                    except ValueError:
                        wait = 2
                    time.sleep(min(wait, 60))
                    continue
                log(f"Discord said {error.code} to: {text[:120]}")
                return
            except Exception as error:
                log(f"could not reach Discord ({error}): {text[:120]}")
                time.sleep(10)


def newest_recording(folder):
    try:
        names = sorted(n for n in os.listdir(os.path.join(folder, "recordings")) if n.endswith(".hrec"))
    except OSError:
        return None
    return names[-1] if names else None


def game_started(folder, recording):
    """when the recording's game began (unix time): its public copy's
    live.json says, else the file's name (UTC, as the server's clock)"""
    try:
        with open(os.path.join(folder, "recordings", "public", "live.json"), encoding="utf-8") as status:
            live = json.load(status)
        if live.get("file") == recording and isinstance(live.get("started"), (int, float)):
            return float(live["started"])
    except (OSError, ValueError):
        pass
    try:
        return float(calendar.timegm(time.strptime(recording[:19], "%Y-%m-%d_%H-%M-%S")))
    except ValueError:
        return None


def replay_links(unit, folder, recording, player, when):
    """the replay viewer's links: the game live, and its public recording
    at the moment (once it is over), following the player"""
    if unit not in PUBLIC:
        return []
    live, kept = PUBLIC[unit]
    lines = [f"Watch live (30 s behind): <{VIEWER}?live={urllib.parse.quote(live, safe='')}>"]
    started = game_started(folder, recording) if recording else None
    if recording and started:
        seconds = max(0, int(when - started) - REPLAY_LEAD_SECONDS)
        moment = f"{seconds // 60}m{seconds % 60:02d}s"
        address = (f"{VIEWER}?file={urllib.parse.quote(kept + recording, safe='')}&t={moment}"
                   f"&p={urllib.parse.quote(player, safe='')}")
        lines.append(f"The moment ({seconds // 60}:{seconds % 60:02d} into the game; once it is over): <{address}>")
    return lines


# ---------- suspects, as the game servers log them

def follow_suspects():
    said = {}
    units = []
    for unit in SERVERS:
        units += ["-u", unit]
    while True:
        process = subprocess.Popen(["journalctl", "-f", "-n", "0", "-o", "json", *units], stdout=subprocess.PIPE,
                                   text=True)
        for line in process.stdout:
            try:
                entry = json.loads(line)
            except ValueError:
                continue
            message = entry.get("MESSAGE")
            if isinstance(message, list):
                message = bytes(message).decode("utf-8", "replace")
            if not isinstance(message, str):
                continue
            # (systemd's own lines about the unit: a crash)
            if "Main process exited" in message and ("code=dumped" in message or "code=killed" in message):
                unit = (entry.get("UNIT") or entry.get("_SYSTEMD_UNIT") or "").removesuffix(".service")
                server = SERVERS.get(unit, (unit or "a game server", None))[0]
                why = message.split("Main process exited, ", 1)[-1].rstrip(".")
                send(f"\N{COLLISION SYMBOL} **{server} crashed** ({why}); systemd is starting it again. "
                     f"Players in its game were dropped. `journalctl -u {unit}`")
                log(f"crash: {server}: {why}")
                continue
            if "fair play: suspect" not in message:
                continue
            unit = (entry.get("_SYSTEMD_UNIT") or "").removesuffix(".service")
            server, folder = SERVERS.get(unit, (unit or "a server", None))
            # "chupathingyce: fair play: suspect (3 refused hits, aim on hidden enemies 0%): Name"
            text = message.split("fair play: suspect", 1)[1]
            why, _, player = text.rpartition("): ")
            why = why.strip(" (")
            player = player.strip() or "someone"
            key = (server, player)
            if time.time() - said.get(key, 0) < SUSPECT_REPEAT_SECONDS:
                continue
            said[key] = time.time()
            recording = newest_recording(folder) if folder else None
            # (when the line came: journald's, in microseconds)
            try:
                when = int(entry.get("__REALTIME_TIMESTAMP")) / 1e6
            except (TypeError, ValueError):
                when = time.time()
            lines = [f"\N{TRIANGULAR FLAG ON POST} **Suspect on {server}: {player}**", f"{why}."]
            lines += replay_links(unit, folder, recording, player, when)
            if recording:
                lines.append(f"Private recording, with the fair play verdicts: `{recording}` "
                             "(the panel's Suspects tab, Recordings).")
            lines.append(f"Watch them now (Moderation screen, Watch), or see `sv_suspects`: {PANELS.get(server, '')}")
            send("\n".join(lines))
            log(f"suspect on {server}: {player} ({why})")
        process.wait()
        time.sleep(5)


# ---------- health, every minute

def unit_state(unit):
    return subprocess.run(["systemctl", "is-active", unit], capture_output=True, text=True).stdout.strip()


def unit_failed(unit):
    return subprocess.run(["systemctl", "is-failed", "--quiet", unit]).returncode == 0


def url_ok(url):
    try:
        request = urllib.request.Request(url, headers={"User-Agent": "halo-alerts"})
        with urllib.request.urlopen(request, timeout=20) as response:
            return 200 <= response.status < 400
    except Exception:
        return False


def listed_servers():
    """the names on the game list, or None if the list itself does not answer"""
    try:
        request = urllib.request.Request(GAME_LIST, headers={"User-Agent": "halo-alerts"})
        with urllib.request.urlopen(request, timeout=20) as response:
            data = json.loads(response.read())
    except Exception:
        return None
    games = data.get("games", data) if isinstance(data, dict) else data
    return {game.get("name") for game in games if isinstance(game, dict)}


def checks():
    """(name, ok, what to say when it fails, how many failures before saying it)"""
    results = []
    for unit in RUNNING:
        state = unit_state(unit)
        results.append((f"unit {unit}", state == "active", f"`{unit}` is {state or 'not running'}", FAILURES_TO_ALERT))
    for unit in NOT_FAILED:
        results.append((f"failed {unit}", not unit_failed(unit),
                        f"`{unit}` failed its last run: `journalctl -u {unit}`", 1))
    results.append(("site", url_ok(SITE), f"the site {SITE} does not answer", FAILURES_TO_ALERT))
    results.append(("lobby", url_ok(LOBBY), "the lobby (the `halo` web services) does not answer", FAILURES_TO_ALERT))
    listed = listed_servers()
    if listed is not None:
        for server, _ in SERVERS.values():
            results.append((f"listed {server}", server in listed, f"{server} is not on the game list (halo.milenko.org)",
                            GAME_LIST_FAILURES_TO_ALERT))
    try:
        status = os.statvfs(DISK_PATH)
        free = status.f_bavail * status.f_frsize
        results.append(("disk", free >= DISK_MINIMUM, f"only {free / 1024 ** 3:.1f} GB of disk left", 1))
    except OSError:
        pass
    return results


def watch_health():
    failures = {}
    alerted = {}
    while True:
        for name, ok, problem, needed in checks():
            if ok:
                if alerted.pop(name, None):
                    send(f"\N{WHITE HEAVY CHECK MARK} Back: {problem.split(' is ')[0] if ' is ' in problem else name} is fine again.")
                    log(f"back: {name}")
                failures[name] = 0
                continue
            failures[name] = failures.get(name, 0) + 1
            if failures[name] >= needed and name not in alerted:
                alerted[name] = True
                send(f"\N{WARNING SIGN} **Halo VPS:** {problem}.")
                log(f"down: {name}: {problem}")
        time.sleep(60)


def main():
    if "--test" in sys.argv:
        send("\N{BELL} halo-alerts can post here: suspects and anything down on the Halo VPS will be said in this channel.")
        return 0
    log("halo-alerts: following the game servers' fair play lines, checking every minute")
    threading.Thread(target=follow_suspects, daemon=True).start()
    watch_health()
    return 0


if __name__ == "__main__":
    sys.exit(main())
