{
  "name": "halo-web-signaling",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.0.0 || >=24.0.0"
  },
  "scripts": {
    "check": "npm run types:check && tsc --noEmit && npm test && npm run deploy:dry",
    "deploy": "wrangler deploy",
    "deploy:dry": "wrangler deploy --dry-run --outdir .wrangler/dry-run",
    "dev": "wrangler dev",
    "test": "vitest run",
    "test:watch": "vitest",
    "types": "wrangler types",
    "types:check": "wrangler types --check"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.3.1",
    "@types/node": "26.6.3",
    "typescript": "6.0.3",
    "vitest": "4.1.11",
    "wrangler": "4.143.0"
  }
}
