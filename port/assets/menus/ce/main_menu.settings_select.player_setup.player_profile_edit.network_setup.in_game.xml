	<strings name="main_menu/settings_select/player_setup/player_profile_edit/network_setup/in_game/help_strings">
		<string text=""/>
		<string text="Text chat and the word filter."/>
		<string text="Players' names above their heads, and the\nscoreboard."/>
		<string text="Downloading Custom Edition maps you do not have,\nand helping send them to other players."/>
		<string text="Hide offensive words in names and text from\nother players, maps and mods."/>
		<string text="Text chat with other players."/>
		<string text="Choose whose chat lines show."/>
		<string text="Mask, hide or show blocked words."/>
		<string text="Show players in chat by team, not by name."/>
		<string text="The text chat of a game an OpenCE machine hosts:\nshow it, or hide it and its keys."/>
		<string text="Its names in their team's color, or all white, as\nCustom Edition."/>
		<string text="Choose whose names show above players."/>
		<string text="Adjust the size of player names."/>
		<string text="Show team games by team, or all players by score."/>
		<string text="Draw a panel behind the scoreboard."/>
		<string text="Joining a game on a Custom Edition map you do not\nhave: download it from the players (if shared)."/>
		<string text="In another's game, send its map to players who\njoin without it, as a torrent's peers do."/>
		<string text="The most you send of maps to other players, so\nthat the game keeps the rest of your upload."/>
		<string text="Hide offensive words in names and text from\nother players, maps and mods, as stars."/>
		<string text="Slurs about race, sexuality, gender and\ndisability."/>
		<string text="Swearing and sexual words (STRONG AND WORSE\nleaves the mildest showing)."/>
		<string text="Name-calling and insults that are not slurs."/>
	</strings>
